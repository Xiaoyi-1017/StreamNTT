constexpr int CORE_DRAM_WIDTH_RATIO = (2*BU) / DataCHLen;

constexpr int POLY_FIFO_DEPTH_S = n / DataCHLen;
constexpr int POLY_FIFO_DEPTH_M = n / (2*BU);

