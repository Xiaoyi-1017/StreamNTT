constexpr int log2(int x) {{
    return (x <= 1) ? 0 : 1 + log2(x / 2);
}}

// Number of coefficients
constexpr int n = {N};
constexpr int logN = {logN};

constexpr int BU = {BU};
constexpr int logBU = {logBU};

// NUM_X_STAGE is available to both the C preprocessor (#if NUM_X_STAGE > 3)
// and C++ runtime (num_x_stage). num_x_stage is a plain constexpr int and
// cannot be used inside #if because the preprocessor does not evaluate it.
#define NUM_X_STAGE ({logBU} + 1)

// WIDTH: number of coeffs processed in parallel (per NTT CORE)
constexpr int WIDTH = 2*BU;
constexpr int DEPTH = n / WIDTH;
constexpr int logDEPTH = {logDEPTH};

constexpr int num_x_stage = NUM_X_STAGE;
constexpr int num_l_stage = logN - (logBU + 1);
#define NUM_L_stage {NUM_L_stage}

// Work 2: per-stage segmented TFG + TFR. No X_SPLIT3 constants needed.

constexpr int num_l_stage_ge1 = num_l_stage - 1;
constexpr int num_l_stage_ge2 = num_l_stage - 2;
constexpr int num_l_stage_ge3 = num_l_stage - 3;  // kept for X-stage index arithmetic

// Segmented TFG Phase 1: stage 3 = 8-entry table; stages >= 4 = base+ratio completion.
#define TFG_SEG_LEN {TFG_SEG_LEN}
#define NUM_L_STAGE_GE4 ({NUM_L_stage} - 4)
constexpr int num_l_stage_ge4 = (num_l_stage > 4) ? (num_l_stage - 4) : 0;
constexpr int NUM_SEG_BLOCKS = DEPTH / TFG_SEG_LEN;
static_assert(DEPTH % TFG_SEG_LEN == 0, "TFG_SEG_LEN must divide DEPTH");
// Flattened stage-0..3 twiddle table: sum(2^s for s=0..3) = 15 entries.
constexpr int TW_L_BASE_TABLE_SIZE = 15;

constexpr int CH = {CH};

constexpr int NUM_CORE = EffDataCHLen*CH / (2*BU);

constexpr int GROUP_NUM = {GROUP_NUM}; //std::min(CH, NUM_CORE);
#define GROUP_CH_NUM {GROUP_CH_NUM}
//constexpr int GROUP_CH_NUM = CH / GROUP_NUM;
constexpr int GROUP_CORE_NUM = NUM_CORE / GROUP_NUM;

#if {MCH} // GROUP_CH_NUM > 1
#define MCH
#endif

