# Ignore all directories generated by generate_code.py
N*_BU*_CH*_*/
# Generated output directory
generated/

# -------- Python --------
# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/
# Virtual environment
venv/
env/

# -------- Build Artifacts --------
# C/C++ intermediate files, executable files
*.o
*.obj
*.exe
build/
dist/

# HLS/FPGA output
*.log
*.err
*.out
*.jou
*.wdb
*.rpt
*.xpr
*.srp
*.db
*.xo
*.xclbin
.vitis*

# keep formal config folders
!configs/

# -------- Editor/IDE --------
# VSCode
.vscode/
# JetBrains
.idea/
*.iml

# macOS
.DS_Store

# Temporary folders
tmp/
Checkpoint/
Spec/
Log/
.claude/

# Keep local tool archives ignored while allowing shared run helpers.
tools/*
!tools/run_watch.sh
!tools/run_tmux_watch.sh

# Temporary files
*~
*.swp
